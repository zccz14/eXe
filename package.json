{
  "name": "exe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  },
  "scripts": {
    "build": "pnpm --dir console build",
    "dev": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit && pnpm --dir console exec tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "vectors": "node --experimental-strip-types scripts/vectors.ts",
    "test:integration": "node --experimental-strip-types scripts/integration.mjs",
    "test:agent": "cargo build --manifest-path agent/Cargo.toml && node --experimental-strip-types scripts/agent-smoke.mjs",
    "db:init": "wrangler d1 execute exe --file worker/src/schema.sql --remote",
    "db:init:local": "wrangler d1 execute exe --file worker/src/schema.sql --local"
  }
}
