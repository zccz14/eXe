{
  "name": "exe",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "typescript": "^7.0.2",
    "wrangler": "4.152.0",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "build": "pnpm --dir console build",
    "dev": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && pnpm --dir console exec tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "vectors": "node --experimental-strip-types scripts/vectors.ts",
    "test:integration": "node --experimental-strip-types scripts/integration.mjs",
    "test:agent": "cargo build --manifest-path agent/Cargo.toml && node --experimental-strip-types scripts/agent-smoke.mjs",
    "db:init": "wrangler d1 execute exe --file worker/src/schema.sql --remote",
    "db:init:local": "wrangler d1 execute exe --file worker/src/schema.sql --local",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check"
  }
}
