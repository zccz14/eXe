{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exe",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "console/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exe",
      "database_id": "0db45c1a-59da-4109-87fc-d025cf4d3aad"
    }
  ],
  "vars": {
    "AUTH_ISSUER": "https://auth.ntnl.io",
    "AUTH_AUDIENCE": "exe.ntnl.io"
  },
  "routes": [{ "pattern": "exe.ntnl.io", "custom_domain": true }],
  "observability": { "enabled": true }
}
