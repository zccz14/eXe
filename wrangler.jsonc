{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exe",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "console/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // `/__scheduled` is dev-only: it lets `wrangler dev --test-scheduled` fire the
    // retention cron locally. In production the worker falls through to the SPA.
    "run_worker_first": ["/api/*", "/v1/*", "/download/*", "/__scheduled"]
  },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "exe-blobs" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exe",
      "database_id": "0db45c1a-59da-4109-87fc-d025cf4d3aad"
    }
  ],
  "vars": {
    "CONSOLE_ORIGINS": "https://exe-console.pages.dev",
    "GITHUB_REPO": "zccz14/eXe"
  },
  "routes": [{ "pattern": "exe.ntnl.io", "custom_domain": true }],
  "triggers": { "crons": ["41 * * * *"] },
  "observability": { "enabled": true }
}
